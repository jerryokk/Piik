{
  "name": "piik",
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0 <27"
  },
  "packageManager": "npm@11.17.0",
  "scripts": {
    "dev": "node scripts/release/package-licenses.mjs public/third-party-licenses.txt && vite",
    "dev:server": "node scripts/run/dev-server.mjs",
    "app": "node scripts/run/app.mjs",
    "app:fresh": "node scripts/run/app.mjs --fresh",
    "build": "npm run build:web",
    "build:web": "node scripts/release/package-licenses.mjs public/third-party-licenses.txt && node --input-type=module -e \"import { readdirSync, rmSync } from 'node:fs'; const dir = 'web/dist'; for (const entry of readdirSync(dir)) { if (entry !== '.gitkeep') rmSync(dir + '/' + entry, { recursive: true, force: true }); }\" && vite build",
    "build:app": "node scripts/run/build-app.mjs",
    "app:runtime": "node scripts/release/prepare-app-runtime.mjs",
    "update:guide-images": "node scripts/utils/update-guide-images.mjs",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "node scripts/checks/check-all.mjs",
    "check:web": "tsc -b --pretty false && vitest run && npm run build:web",
    "check:rust": "node scripts/checks/check-rust.mjs",
    "check:rust-core": "node scripts/checks/check-rust.mjs --core",
    "check:native": "node scripts/checks/check-rust.mjs --capture-only",
    "check:docs": "node scripts/checks/check-docs.mjs",
    "check:size": "node scripts/checks/check-source-size.mjs",
    "check:hygiene": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/checks/check-project-state.ps1",
    "package:app": "node scripts/release/assemble-app.mjs",
    "package:app-candidate": "node scripts/release/package-app-candidate.mjs",
    "gate:app-media": "tsx scripts/gates/app-media-gate.ts",
    "gate:app-native-host": "tsx scripts/gates/app-native-host-gate.ts",
    "gate:app-browser-fanout": "tsx scripts/gates/app-browser-fanout-gate.ts",
    "gate:embedded-sfu": "tsx scripts/gates/embedded-sfu-gate.ts",
    "gate:room-voice": "tsx scripts/gates/room-voice-gate.ts",
    "gate:app-link": "tsx scripts/gates/app-link-gate.ts",
    "gate:peer-topology-loopback": "tsx scripts/gates/peer-topology-gate.ts",
    "gate:sfu-admission": "vitest run tests/sfu-client.test.ts tests/route-transition && cargo test --locked -p piik-sfu -p piik-signal -p piik-route",
    "gate:access-privacy": "npm run build:web && tsx scripts/gates/access-privacy-gate.ts",
    "gate:app-loopback": "tsx scripts/gates/app-loopback-gate.ts",
    "gate:app-local": "tsx scripts/gates/app-local-gate.ts",
    "gate:app-invite-code": "tsx scripts/gates/app-invite-code-gate.ts"
  },
  "devDependencies": {
    "@oddbird/popover-polyfill": "0.7.3",
    "@types/node": "24.13.3",
    "@types/pngjs": "6.0.5",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@types/sdp-transform": "3.0.0",
    "@types/semver": "7.8.0",
    "@types/ws": "8.18.1",
    "@vitejs/plugin-react": "6.0.5",
    "esbuild": "0.28.2",
    "jsqr": "1.4.0",
    "pngjs": "7.0.0",
    "qrcode-generator": "2.0.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sdp-transform": "3.0.0",
    "semver": "7.8.5",
    "tsx": "4.23.13",
    "typescript": "~6.0.3",
    "vite": "8.2.4",
    "vitest": "4.1.12",
    "ws": "8.21.3",
    "zod": "4.6.6"
  }
}
